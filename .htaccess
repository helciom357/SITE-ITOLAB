# ITO Digital Dental Lab — configuração para hospedagem Apache (Hostinger)

Options -Indexes
DirectoryIndex index.html

# Forçar HTTPS (ative depois que o SSL estiver ativo no domínio)
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Não servir arquivos de desenvolvimento
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(src|vendor|dev)/ - [F,L]
  RewriteRule ^(package\.json|jsconfig\.json|README\.md|\.git.*)$ - [F,L]
</IfModule>

<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType font/woff .woff
  AddType image/svg+xml .svg
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml font/woff application/json
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "chunks/.*\.js$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
